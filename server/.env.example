# Phantom AI training server env
#
# MongoDB connection string. The database name is taken from the URL path
# when present, otherwise it defaults to "phantom-ai-training". The server
# creates the collections (clients / models / scores) on first use.
# Leave empty to run without Mongo (API routes return 503, /healthz works).
MONGO_URL=mongodb://user:password@host:27017/phantom-ai-training

# Port the server listens on (Railway injects PORT automatically)
PORT=3000

# Relative tolerance for score verification: the replayed score from the
# verifying browser must reach at least score * (1 - VERIFY_TOLERANCE).
VERIFY_TOLERANCE=0.05
